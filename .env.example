# API
# Em producao com Nginx fazendo proxy de /api para o backend:
VITE_API_URL={origin}/api

# Compatibilidade com a configuracao historica do projeto.
# Se VITE_API_URL estiver preenchida, ela tem prioridade.
VITE_API_BASE_URL={origin}/api

# Multitenant por subdominio.
VITE_APP_HOSTNAME_BASE=meudominio.com.br

# Use "same" quando o backend estiver no mesmo host via Nginx.
VITE_API_PORT=same
VITE_API_BASE_PATH=/api
VITE_API_TIMEOUT_MS=15000
VITE_API_CREDENTIALS_MODE=same-origin
VITE_AUTH_TOKEN_STORAGE_KEY=connexi.access-token

# Suporte comercial/landing page, se utilizado.
VITE_SUPPORT_WHATSAPP_NUMBER=

# Desenvolvimento local, se precisar:
# VITE_API_URL=http://{hostname}:3000
# VITE_API_BASE_URL=http://{hostname}:3000
# VITE_APP_HOSTNAME_BASE=localhost
# VITE_API_PORT=3000
# VITE_API_BASE_PATH=
